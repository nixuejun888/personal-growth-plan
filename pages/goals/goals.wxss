/* 目标步骤拆解：步骤编辑行 */
.step-row {
    display: flex;
    align-items: center;
    gap: 12rpx;
    margin-bottom: 12rpx;
}

.step-index {
    width: 40rpx;
    height: 40rpx;
    line-height: 40rpx;
    text-align: center;
    border-radius: 50%;
    background: rgba(6, 182, 212, .15);
    color: #06b6d4;
    font-size: 24rpx;
    flex-shrink: 0;
}
